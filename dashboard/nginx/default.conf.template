# The nginx image runs envsubst on this file at start and writes the result to
# /etc/nginx/conf.d/default.conf. Only ${API_UPSTREAM} is an environment variable.
# Names such as $uri and $host are nginx variables and stay as they are.

# "Connection: upgrade" for WebSocket requests, "close" for everything else.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Vite puts a content hash in every file name under /assets/, so the
    # browser can keep them for a year. A missing asset is a 404, not index.html.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html names the current hashed assets, so the browser must always revalidate it.
    location = /version.json {
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Single page app: unknown paths return index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # proxy_pass has no URI part, so nginx forwards the full path (/api/...) unchanged.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The live feed stays open for a long time.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location = /healthz {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }
}
