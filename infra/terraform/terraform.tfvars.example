# Copy to terraform.tfvars (git ignores it) and replace the placeholders.
#   az account list --query "[].{name:name, id:id, tenant:tenantId}" -o table

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# Optional overrides (defaults shown).
# location           = "eastus2"
# node_vm_size       = "Standard_D2as_v6"
# node_count         = 1
# kubernetes_version = null
# log_daily_quota_gb = -1
# alert_email        = ""   # comma-separated emails for Prod alerts
# enable_dev_log_alerts = false
# availability_test_frequency = 900
# github_repo        = "m1ttt/editwar-sentinel"
# create_github_identity = true

# GitHub repositories with immutable OIDC subjects need the full prefix:
#   gh api repos/m1ttt/editwar-sentinel/actions/oidc/customization/sub --jq .sub_claim_prefix
# github_subject_prefix = "repo:<owner>@<owner-id>/<repo>@<repo-id>"
